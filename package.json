{
  "name": "excel-mcp-server",
  "version": "0.1.0",
  "description": "Local Model Context Protocol server for exploring Excel workbooks. Uses ExcelJS to parse .xlsx and HyperFormula as the formula engine. Works with VS Code, Claude Desktop, and any MCP-compatible client.",
  "type": "module",
  "bin": {
    "excel-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"import('node:fs').then(f=>f.chmodSync('dist/index.js',0o755))\"",
    "clean": "rm -rf dist coverage",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "exceljs": "^4.4.0",
    "hyperformula": "^2.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "excel",
    "xlsx",
    "hyperformula",
    "exceljs",
    "vscode",
    "claude",
    "spreadsheet"
  ],
  "license": "GPL-3.0-or-later",
  "author": "manil2020",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manil2020/excel_mcp_server.git"
  },
  "bugs": {
    "url": "https://github.com/manil2020/excel_mcp_server/issues"
  },
  "homepage": "https://github.com/manil2020/excel_mcp_server#readme"
}
